# Facultatif. La configuration Firebase de GULP! est déjà dans src/config/firebaseConfig.js
# (projet gulp-637e2). Ce fichier ne sert qu'à pointer vers un AUTRE projet Firebase
# (par exemple un projet de test) : copie-le en .env.local et décommente les lignes.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Optionnel — rayon (en mètres) autour d'un bar pour qu'une perf soit classée. Défaut : 100.
# VITE_GEOFENCE_RADIUS=100

# Optionnel — true = le chrono refuse de partir hors d'un bar de la liste. Défaut : chrono libre.
# VITE_REQUIRE_BAR=true
